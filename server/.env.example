# Copy this file to .env and fill in your own values.
# Local Postgres example: postgresql://USER:PASSWORD@localhost:5432/trippin
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trippin"
PORT=5000
# Optional: database used by `npm test`. It gets wiped, so its name must end in "_test".
# Defaults to the DATABASE_URL database name with "_test" added.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trippin_test"
